<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Tema">

        <activity
            android:name=".telas.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".telas.MarketplaceActivity" android:windowSoftInputMode="adjustPan" />
        <activity android:name=".telas.PromptActivity" />
        <activity android:name=".telas.BibliotecaActivity" />
        <activity android:name=".telas.CriadorActivity" android:windowSoftInputMode="adjustPan" />
        <activity android:name=".telas.ComunidadeActivity" android:windowSoftInputMode="adjustPan" />
        <activity android:name=".telas.MaisActivity" />
        <activity android:name=".telas.PlanosActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".telas.ComissoesActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".telas.HistoricoActivity" />
        <activity android:name=".telas.NegocioActivity" />
    </application>
</manifest>
