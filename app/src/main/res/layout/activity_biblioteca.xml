<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <ScrollView android:id="@+id/rolagem"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp" android:paddingTop="22dp">

            <TextView style="@style/TituloGrande"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/biblioteca_titulo" />

            <TextView style="@style/Subtitulo"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/biblioteca_sub" />

            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:orientation="horizontal">
                <TextView android:id="@+id/aba_comprados" style="@style/Chip"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/aba_favoritos" style="@style/Chip"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout android:id="@+id/lista" style="@style/Lista"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_nav" />
</FrameLayout>
