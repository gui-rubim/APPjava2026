<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:paddingBottom="110dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="20dp">

            <TextView style="@style/TituloGrande"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/nav_biblioteca" />

            <TextView android:id="@+id/txt_subtitulo" style="@style/Corpo"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:layout_marginBottom="20dp" />

            <!-- Estado vazio -->
            <LinearLayout android:id="@+id/vazio" style="@style/Cartao"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_horizontal" android:orientation="vertical" android:padding="28dp">

                <ImageView
                    android:layout_width="56dp" android:layout_height="56dp"
                    android:background="@drawable/icone_fundo" android:padding="14dp"
                    android:src="@drawable/ic_biblioteca" android:tint="@color/azul_claro"
                    android:importantForAccessibility="no" />

                <TextView style="@style/Titulo"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="@string/nada_aqui" />

                <TextView style="@style/Corpo"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:gravity="center"
                    android:text="@string/nada_texto" />
            </LinearLayout>

            <LinearLayout android:id="@+id/lista" style="@style/Cartao"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:divider="@drawable/divisor" android:showDividers="middle"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_nav" />
</FrameLayout>
