<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/azul" android:orientation="vertical">

    <include layout="@layout/barra_topo" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="32dp">

            <TextView style="@style/TituloGrande" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/negocio_titulo" android:textColor="@color/branco" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:lineSpacingExtra="3dp"
                android:text="@string/negocio_sub" android:textColor="@color/branco_80" android:textSize="15sp" />

            <LinearLayout android:id="@+id/lista_receitas"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:divider="@drawable/divisor_azul"
                android:orientation="vertical" android:showDividers="beginning|middle|end" />

            <!-- Simulador -->
            <LinearLayout style="@style/Cartao"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:orientation="vertical" android:padding="20dp">

                <TextView style="@style/Titulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/simulador_titulo" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/vendas_mes" android:textColor="@color/tinta" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:id="@+id/txt_sim_vendas" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/tinta" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
                <SeekBar android:id="@+id/seek_vendas" style="@style/Barra"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:max="199" android:progress="19" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/ticket_medio" android:textColor="@color/tinta" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:id="@+id/txt_sim_ticket" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/tinta" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
                <SeekBar android:id="@+id/seek_ticket" style="@style/Barra"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:max="55" android:progress="15" />

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:background="@drawable/cartao_papel"
                    android:orientation="vertical" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/Pequeno" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="@string/volume" android:textColor="@color/tinta" />
                        <TextView android:id="@+id/txt_sim_volume" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/tinta" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:orientation="horizontal">
                        <TextView style="@style/Pequeno" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="@string/repasse" android:textColor="@color/tinta" />
                        <TextView android:id="@+id/txt_sim_repasse" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/tinta" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView style="@style/Pequeno" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="@string/receita" android:textColor="@color/tinta" />
                        <TextView android:id="@+id/txt_sim_receita" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:fontFamily="@font/bricolage_extrabold" android:textColor="@color/azul" android:textSize="24sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView style="@style/Pequeno" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="@string/simulador_nota" android:textSize="12sp" />
            </LinearLayout>

            <TextView style="@style/Titulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="28dp" android:text="@string/roadmap" android:textColor="@color/branco" />
            <LinearLayout android:id="@+id/lista_fases"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
