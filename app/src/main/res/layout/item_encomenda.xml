<?xml version="1.0" encoding="utf-8"?>
<!-- Encomenda (comissão personalizada) com as 5 etapas -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Cartao"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:orientation="vertical">

    <TextView android:id="@+id/enc_criador" style="@style/Titulo"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" />

    <TextView android:id="@+id/enc_info" style="@style/Pequeno"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" />

    <TextView android:id="@+id/enc_briefing"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="@color/suave" android:textSize="14sp" />

    <LinearLayout android:id="@+id/enc_etapas"
        android:layout_width="match_parent" android:layout_height="6dp"
        android:layout_marginTop="14dp" android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">

        <TextView android:id="@+id/enc_status"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/azul" android:textSize="15sp" android:textStyle="bold" />

        <Button android:id="@+id/enc_botao" style="@style/BotaoSecundario"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="38dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:textSize="13sp" />

        <TextView android:id="@+id/enc_liberado" style="@style/Pequeno"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/pagamento_liberado" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
