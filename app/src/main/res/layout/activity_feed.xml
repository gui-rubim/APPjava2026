<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:paddingBottom="110dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp">

            <!-- Cabeçalho -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">

                <TextView android:id="@+id/txt_iniciais"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:background="@drawable/circulo_azul" android:gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/branco" android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView android:id="@+id/txt_ola"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/texto_2" android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium" android:textStyle="bold"
                        android:text="PromptPlace" android:textColor="@color/texto" android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Cartão de destaque com gradiente -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/cartao_destaque" android:elevation="6dp"
                android:orientation="vertical" android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/sua_biblioteca" android:textColor="#CCFFFFFF" android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:gravity="bottom" android:orientation="horizontal">

                    <TextView android:id="@+id/txt_total_prompts"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium" android:letterSpacing="-0.03"
                        android:textColor="@color/branco" android:textSize="46sp" android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" android:layout_marginBottom="10dp"
                        android:text="@string/prompts" android:textColor="#CCFFFFFF" android:textSize="16sp" />
                </LinearLayout>

                <TextView android:id="@+id/txt_resumo"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#CCFFFFFF" android:textSize="14sp" />

                <TextView android:id="@+id/btn_ver_biblioteca"
                    android:layout_width="wrap_content" android:layout_height="44dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/botao_branco"
                    android:drawableEnd="@drawable/ic_seta" android:drawablePadding="4dp"
                    android:drawableTint="@color/azul_escuro"
                    android:fontFamily="sans-serif-medium" android:gravity="center"
                    android:paddingStart="18dp" android:paddingEnd="12dp"
                    android:text="@string/abrir_biblioteca"
                    android:textColor="@color/azul_escuro" android:textSize="14sp" />
            </LinearLayout>

            <TextView style="@style/Secao"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/criadores" />

            <!-- Filtro por categoria (controle segmentado) -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/segmentos"
                android:orientation="horizontal" android:padding="4dp">

                <TextView android:id="@+id/btn_todos" style="@style/Segmento"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:text="@string/filtro_todos" />
                <TextView android:id="@+id/btn_imagem" style="@style/Segmento"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:text="@string/filtro_imagem" />
                <TextView android:id="@+id/btn_texto" style="@style/Segmento"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:text="@string/filtro_texto" />
                <TextView android:id="@+id/btn_codigo" style="@style/Segmento"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:text="@string/filtro_codigo" />
            </LinearLayout>

            <LinearLayout android:id="@+id/lista"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_nav" />
</FrameLayout>
