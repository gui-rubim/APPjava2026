<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_horizontal" android:orientation="vertical"
        android:paddingStart="24dp" android:paddingEnd="24dp"
        android:paddingTop="16dp" android:paddingBottom="32dp">

        <!-- Seletor de idioma: EN (principal) | PT -->
        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="40dp"
            android:layout_gravity="end"
            android:background="@drawable/segmentos"
            android:orientation="horizontal" android:padding="3dp">

            <TextView android:id="@+id/btn_en" style="@style/Segmento"
                android:layout_width="48dp" android:layout_height="match_parent"
                android:text="EN" android:textSize="13sp" />
            <TextView android:id="@+id/btn_pt" style="@style/Segmento"
                android:layout_width="48dp" android:layout_height="match_parent"
                android:text="PT" android:textSize="13sp" />
        </LinearLayout>

        <!-- Logo com brilho atrás -->
        <FrameLayout
            android:layout_width="260dp" android:layout_height="260dp">

            <View
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/brilho" />

            <FrameLayout
                android:layout_width="92dp" android:layout_height="92dp"
                android:layout_gravity="center"
                android:background="@drawable/logo_fundo" android:elevation="16dp">

                <ImageView
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/ic_logo_frente" android:importantForAccessibility="no" />
            </FrameLayout>
        </FrameLayout>

        <TextView style="@style/TituloGrande"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/login_titulo" android:textSize="28sp" />

        <TextView style="@style/Corpo"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:layout_marginBottom="36dp"
            android:gravity="center"
            android:text="@string/login_subtitulo" />

        <EditText android:id="@+id/edt_nome" style="@style/Campo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/hint_nome" android:imeOptions="actionNext"
            android:inputType="textPersonName|textCapWords" />

        <EditText android:id="@+id/edt_email" style="@style/Campo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_email" android:imeOptions="actionDone"
            android:inputType="textEmailAddress" />

        <Button android:id="@+id/btn_entrar" style="@style/BotaoPrimario"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/continuar" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:gravity="center"
            android:text="@string/aviso_demo"
            android:textColor="@color/texto_3" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
