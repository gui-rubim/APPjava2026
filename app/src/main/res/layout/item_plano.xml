<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão de plano (Gratuito, Pro, Equipes) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="14dp">

    <LinearLayout android:id="@+id/plano_cartao"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:background="@drawable/cartao" android:orientation="vertical" android:padding="20dp">

        <TextView android:id="@+id/plano_nome" style="@style/Titulo"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:baselineAligned="true" android:orientation="horizontal">
            <TextView android:id="@+id/plano_preco"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/bricolage_extrabold" android:letterSpacing="-0.02"
                android:textColor="@color/tinta" android:textSize="36sp" />
            <TextView android:id="@+id/plano_por_mes"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:text="@string/por_mes"
                android:textColor="@color/suave" android:textSize="14sp" />
        </LinearLayout>

        <TextView android:id="@+id/plano_nota" style="@style/Pequeno"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />

        <LinearLayout android:id="@+id/plano_recursos"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:orientation="vertical" />

        <Button android:id="@+id/plano_botao" style="@style/BotaoSecundario"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <TextView android:id="@+id/plano_tag"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_marginEnd="18dp"
        android:background="@drawable/tag_amarela" android:elevation="2dp"
        android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp"
        android:text="@string/mais_escolhido" android:textColor="@color/tinta"
        android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />
</FrameLayout>
