<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/papel" android:orientation="vertical">

    <include layout="@layout/barra_topo" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="32dp">

            <TextView style="@style/Subtitulo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/historico_sub" />

            <LinearLayout android:id="@+id/estatisticas"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:orientation="vertical" />

            <LinearLayout android:id="@+id/lista" style="@style/Lista"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />

            <Button android:id="@+id/btn_exportar" style="@style/BotaoSecundario"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:drawableStart="@drawable/ic_exportar"
                android:text="@string/exportar_csv" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
