<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/barra_topo" />

    <ScrollView
        android:layout_width="match_parent" android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="32dp">

            <!-- Autor -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">

                <ImageView android:id="@+id/img_foto"
                    android:layout_width="36dp" android:layout_height="36dp"
                    android:background="@drawable/circulo" android:scaleType="centerCrop"
                    android:importantForAccessibility="no" />

                <TextView android:id="@+id/txt_autor"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:layout_weight="1"
                    android:textColor="@color/texto_2" android:textSize="14sp" />

                <TextView android:id="@+id/txt_categoria" style="@style/Pilula"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView android:id="@+id/txt_titulo" style="@style/TituloGrande"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <!-- Caixa do prompt -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/caixa_codigo" android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="18dp" android:layout_marginTop="14dp"
                    android:drawableStart="@drawable/ic_documento" android:drawablePadding="6dp"
                    android:drawableTint="@color/azul_claro"
                    android:fontFamily="monospace" android:gravity="center_vertical"
                    android:letterSpacing="0.1" android:text="@string/prompt_rotulo"
                    android:textColor="@color/texto_3" android:textSize="11sp" />

                <TextView android:id="@+id/txt_conteudo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="monospace" android:lineSpacingExtra="5dp"
                    android:padding="18dp" android:textColor="#E4E4F0"
                    android:textIsSelectable="true" android:textSize="14sp" />
            </LinearLayout>

            <Button android:id="@+id/btn_copiar" style="@style/BotaoPrimario"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:minHeight="60dp"
                android:drawableStart="@drawable/ic_copiar"
                android:paddingStart="24dp" android:paddingEnd="24dp"
                android:text="@string/copiar_prompt" android:textSize="17sp" />

            <TextView style="@style/Secao"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/avalie" />

            <LinearLayout style="@style/Cartao"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <RatingBar android:id="@+id/rating"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:numStars="5" android:stepSize="1"
                    android:progressBackgroundTint="@color/linha"
                    android:progressTint="@color/azul"
                    android:secondaryProgressTint="@color/linha" />

                <EditText android:id="@+id/edt_comentario" style="@style/Campo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/hint_comentario" android:inputType="textCapSentences|textMultiLine" />

                <Button android:id="@+id/btn_avaliar" style="@style/BotaoSecundario"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/publicar_avaliacao" />
            </LinearLayout>

            <TextView android:id="@+id/txt_nota" style="@style/Secao"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />

            <LinearLayout android:id="@+id/lista_avaliacoes" style="@style/Cartao"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:divider="@drawable/divisor" android:showDividers="middle"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
