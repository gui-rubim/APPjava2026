<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:paddingBottom="110dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="20dp">

            <TextView style="@style/TituloGrande"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/perfil" />

            <!-- Usuário -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical" android:orientation="horizontal">

                <TextView android:id="@+id/txt_iniciais"
                    android:layout_width="72dp" android:layout_height="72dp"
                    android:background="@drawable/circulo_azul" android:gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/branco" android:textSize="26sp" />

                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="16dp" android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView android:id="@+id/txt_nome" style="@style/Titulo"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="22sp" />
                    <TextView android:id="@+id/txt_email"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/texto_2" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Resumo (texto do método exibirPerfil) -->
            <TextView android:id="@+id/txt_resumo" style="@style/Pilula"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <TextView style="@style/Secao"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/minhas_assinaturas" />

            <LinearLayout android:id="@+id/lista_assinaturas" style="@style/Cartao"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:divider="@drawable/divisor" android:showDividers="middle"
                android:orientation="vertical" />

            <TextView style="@style/Secao"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/painel_financeiro" />

            <!-- Receita da plataforma em destaque -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/cartao_destaque"
                android:orientation="vertical" android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/receita_plataforma" android:textColor="#CCFFFFFF" android:textSize="14sp" />
                <TextView android:id="@+id/txt_receita"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium" android:letterSpacing="-0.03"
                    android:textColor="@color/branco" android:textSize="40sp" android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/criadores_recebem" android:textColor="#CCFFFFFF" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/lista_financeiro" style="@style/Cartao"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:divider="@drawable/divisor" android:showDividers="middle"
                android:orientation="vertical" />

            <!-- Idioma: English (principal) ou Português -->
            <TextView style="@style/Secao"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/idioma" />

            <LinearLayout android:id="@+id/lista_idiomas" style="@style/Cartao"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:divider="@drawable/divisor" android:showDividers="middle"
                android:orientation="vertical" />

            <Button android:id="@+id/btn_sair" style="@style/BotaoSecundario"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:drawableStart="@drawable/ic_sair"
                android:paddingStart="20dp" android:paddingEnd="20dp"
                android:text="@string/sair" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_nav" />
</FrameLayout>
