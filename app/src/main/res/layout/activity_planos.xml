<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/papel" android:orientation="vertical">

    <include layout="@layout/barra_topo" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="32dp">

            <TextView style="@style/Subtitulo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/planos_sub" />

            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:orientation="horizontal">
                <TextView android:id="@+id/aba_mensal" style="@style/Chip"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mensal" />
                <TextView android:id="@+id/aba_anual" style="@style/Chip"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/anual" />
            </LinearLayout>
            <TextView style="@style/Pequeno" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/anual_desconto" />

            <LinearLayout android:id="@+id/lista_planos"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:orientation="vertical" />

            <!-- Apoie quem cria -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:background="@drawable/cartao_amarelo"
                android:orientation="vertical" android:padding="20dp">

                <TextView style="@style/Titulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/apoie_titulo" android:textSize="22sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/apoie_sub"
                    android:textColor="@color/tinta" android:textSize="14.5sp" />

                <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/campo_criador" />
                <TextView android:id="@+id/btn_escolher_criador" style="@style/Campo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_seta" android:drawableTint="@color/suave" android:gravity="center_vertical" />

                <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/valor_doacao" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/valor_5" style="@style/Chip"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$ 5" />
                    <TextView android:id="@+id/valor_10" style="@style/Chip"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$ 10" />
                    <TextView android:id="@+id/valor_25" style="@style/Chip"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$ 25" />
                </LinearLayout>
                <EditText android:id="@+id/edt_outro_valor" style="@style/Campo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:digits="0123456789.,"
                    android:hint="@string/outro_valor" android:inputType="numberDecimal" />

                <Button android:id="@+id/btn_doar" style="@style/BotaoPrimario"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="@string/doar" />
                <Button android:id="@+id/btn_assinar_criador" style="@style/BotaoSecundario"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
