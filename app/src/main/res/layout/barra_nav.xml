<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de navegação flutuante (como a do protótipo) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/barra_nav"
    android:layout_width="match_parent" android:layout_height="64dp"
    android:layout_gravity="bottom"
    android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="14dp"
    android:background="@drawable/barra_nav_fundo" android:elevation="10dp"
    android:orientation="horizontal" android:padding="5dp">

    <LinearLayout android:id="@+id/nav_marketplace" style="@style/ItemNav"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
        <ImageView android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_loja" android:importantForAccessibility="no" />
        <TextView style="@style/TextoNav" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/nav_marketplace" />
    </LinearLayout>

    <LinearLayout android:id="@+id/nav_biblioteca" style="@style/ItemNav"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
        <ImageView android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_biblioteca" android:importantForAccessibility="no" />
        <TextView style="@style/TextoNav" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/nav_biblioteca" />
    </LinearLayout>

    <LinearLayout android:id="@+id/nav_criar" style="@style/ItemNav"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
        <ImageView android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_adicionar" android:importantForAccessibility="no" />
        <TextView style="@style/TextoNav" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/nav_criar" />
    </LinearLayout>

    <LinearLayout android:id="@+id/nav_comunidade" style="@style/ItemNav"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
        <ImageView android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_comunidade" android:importantForAccessibility="no" />
        <TextView style="@style/TextoNav" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/nav_comunidade" />
    </LinearLayout>

    <LinearLayout android:id="@+id/nav_mais" style="@style/ItemNav"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
        <ImageView android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_mais" android:importantForAccessibility="no" />
        <TextView style="@style/TextoNav" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/nav_mais" />
    </LinearLayout>
</LinearLayout>
