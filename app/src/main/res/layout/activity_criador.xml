<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <ScrollView android:id="@+id/rolagem"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp" android:paddingTop="22dp">

            <TextView style="@style/TituloGrande"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/criador_titulo" />

            <TextView style="@style/Subtitulo"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/criador_sub" />

            <!-- Vitrine do criador -->
            <LinearLayout style="@style/Cartao"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <FrameLayout android:id="@+id/avatar_voce"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/txt_nome" style="@style/Titulo"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" />
                        <TextView android:id="@+id/txt_resumo" style="@style/Pequeno"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <TextView style="@style/Subtitulo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/criador_descricao" android:textSize="14sp" />

                <LinearLayout android:id="@+id/estatisticas"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="vertical" />
            </LinearLayout>

            <TextView style="@style/Titulo"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="26dp" android:text="@string/meus_prompts" android:textSize="18sp" />

            <LinearLayout android:id="@+id/lista_meus" style="@style/Lista"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <TextView style="@style/Titulo"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="26dp" android:text="@string/publicar_novo" android:textSize="18sp" />

            <!-- Formulário de publicação -->
            <LinearLayout style="@style/Cartao"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:orientation="vertical" android:paddingTop="6dp">

                <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/campo_titulo" />
                <EditText android:id="@+id/edt_titulo" style="@style/Campo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="@string/campo_titulo_hint" android:inputType="textCapSentences" />

                <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/campo_categoria" />
                <HorizontalScrollView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                    <LinearLayout android:id="@+id/chips_categoria"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/campo_preco" />
                <EditText android:id="@+id/edt_preco" style="@style/Campo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:digits="0123456789.," android:inputType="numberDecimal" android:text="19.90" />

                <TextView android:id="@+id/txt_voce_recebe"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:background="@drawable/caixa_amarela"
                    android:padding="12dp" android:textColor="@color/tinta" android:textSize="14sp" />

                <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/campo_funciona" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <CheckBox android:id="@+id/cb_chatgpt" style="@style/Caixa"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:checked="true" android:text="ChatGPT" />
                    <CheckBox android:id="@+id/cb_claude" style="@style/Caixa"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Claude" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <CheckBox android:id="@+id/cb_gemini" style="@style/Caixa"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Gemini" />
                    <CheckBox android:id="@+id/cb_midjourney" style="@style/Caixa"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Midjourney" />
                </LinearLayout>

                <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/campo_descricao" />
                <EditText android:id="@+id/edt_descricao" style="@style/Campo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="@string/campo_descricao_hint" android:inputType="textCapSentences" />

                <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/campo_prompt" />
                <EditText android:id="@+id/edt_conteudo" style="@style/Campo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains" android:gravity="top"
                    android:hint="@string/campo_prompt_hint" android:inputType="textMultiLine|textCapSentences"
                    android:minLines="5" android:textSize="13sp" />

                <TextView style="@style/Pequeno"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/colchetes_dica" android:textSize="12sp" />

                <Button android:id="@+id/btn_publicar" style="@style/BotaoPrimario"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="@string/publicar" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_nav" />
</FrameLayout>
