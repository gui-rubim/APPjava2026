<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/papel" android:orientation="vertical">

    <include layout="@layout/barra_topo" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="32dp">

            <TextView style="@style/Subtitulo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/comissoes_sub" />

            <LinearLayout android:id="@+id/lista_passos" style="@style/Lista"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />

            <TextView style="@style/Titulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="26dp" android:text="@string/nova_encomenda" android:textSize="18sp" />

            <LinearLayout style="@style/Cartao"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:orientation="vertical" android:paddingTop="6dp">

                <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/campo_criador" />
                <TextView android:id="@+id/btn_escolher_criador" style="@style/Campo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_seta" android:drawableTint="@color/suave" android:gravity="center_vertical" />

                <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/briefing" />
                <EditText android:id="@+id/edt_briefing" style="@style/Campo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="top" android:hint="@string/briefing_hint"
                    android:inputType="textMultiLine|textCapSentences" android:minLines="4" />

                <TextView android:id="@+id/txt_orcamento" style="@style/Rotulo"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <SeekBar android:id="@+id/seek_orcamento" style="@style/Barra"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:max="27" android:progress="6" />

                <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/prazo" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/prazo_3" style="@style/Chip"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/prazo_7" style="@style/Chip"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/prazo_15" style="@style/Chip"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <Button android:id="@+id/btn_enviar" style="@style/BotaoPrimario"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="@string/enviar_encomenda" />
            </LinearLayout>

            <TextView style="@style/Titulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="26dp" android:text="@string/minhas_encomendas" android:textSize="18sp" />
            <LinearLayout android:id="@+id/lista_encomendas"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
