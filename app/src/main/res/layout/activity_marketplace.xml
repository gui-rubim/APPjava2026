<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Cabeçalho azul -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/azul" android:orientation="vertical"
                android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="12dp" android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <FrameLayout
                        android:layout_width="32dp" android:layout_height="32dp"
                        android:background="@drawable/logo_fundo_amarelo">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:src="@drawable/ic_logo_frente" android:tint="@color/azul"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <include layout="@layout/carteira" />
                </LinearLayout>

                <TextView style="@style/TituloGrande"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="22dp" android:text="@string/marketplace"
                    android:textColor="@color/branco" android:textSize="34sp" />

                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:lineSpacingExtra="2dp"
                    android:text="@string/marketplace_sub" android:textColor="@color/branco_80" android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="50dp"
                    android:layout_marginTop="18dp" android:background="@drawable/busca_fundo"
                    android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_busca" android:tint="@color/suave"
                        android:importantForAccessibility="no" />
                    <EditText android:id="@+id/edt_busca"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:background="@null" android:hint="@string/busca_hint"
                        android:imeOptions="actionSearch" android:inputType="text" android:maxLines="1"
                        android:paddingStart="10dp" android:paddingEnd="16dp"
                        android:textColor="@color/tinta" android:textColorHint="#8A8FB0" android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Filtros e lista -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/txt_contador" style="@style/Pequeno"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <TextView android:id="@+id/btn_ordenar" style="@style/Chip"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="0dp"
                        android:drawableStart="@drawable/ic_ordenar" android:drawablePadding="6dp"
                        android:drawableTint="@color/tinta" android:paddingStart="12dp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:scrollbars="none">
                    <LinearLayout android:id="@+id/chips"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout android:id="@+id/lista"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_nav" />
</FrameLayout>
