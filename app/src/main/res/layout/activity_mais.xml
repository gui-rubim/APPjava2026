<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <ScrollView android:id="@+id/rolagem"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp" android:paddingTop="22dp">

            <TextView style="@style/TituloGrande"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/mais_titulo" />


            <!-- Usuário -->
            <LinearLayout style="@style/Cartao"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal">
                <FrameLayout android:id="@+id/avatar_usuario"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/txt_nome" style="@style/Titulo"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" />
                    <TextView android:id="@+id/txt_email" style="@style/Pequeno"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/txt_resumo"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:textColor="@color/azul" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Saldo de demonstração -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="@drawable/carteira_cartao"
                android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/saldo_demo" android:textColor="@color/branco_80" android:textSize="14sp" />
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/txt_saldo"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:fontFamily="@font/bricolage_extrabold"
                        android:textColor="@color/branco" android:textSize="32sp" />
                    <TextView android:id="@+id/btn_recarregar"
                        android:layout_width="wrap_content" android:layout_height="38dp"
                        android:background="@drawable/botao_amarelo" android:gravity="center"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:text="@string/mais_100" android:textColor="@color/tinta"
                        android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/saldo_demo_nota"
                    android:textColor="@color/branco_80" android:textSize="12.5sp" />
            </LinearLayout>

            <TextView style="@style/Titulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="26dp" android:text="@string/modulos" android:textSize="18sp" />
            <LinearLayout android:id="@+id/lista_modulos" style="@style/Lista"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />

            <TextView style="@style/Titulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="26dp" android:text="@string/idioma" android:textSize="18sp" />
            <LinearLayout android:id="@+id/lista_idiomas" style="@style/Lista"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />

            <TextView style="@style/Titulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="26dp" android:text="@string/demonstracao" android:textSize="18sp" />
            <LinearLayout android:id="@+id/lista_demo" style="@style/Lista"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_nav" />
</FrameLayout>
